# Password required to log into the CRM (single owner login, no username).
ADMIN_PASSWORD=changeme123

# Secret used to sign the session cookie. Change this in production.
SESSION_SECRET=dev-session-secret-change-me

# Port the Express/tRPC API server listens on.
PORT=4000

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/mega-clean.sqlite

# Comma-separated list of allowed CORS origins for the API (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173
