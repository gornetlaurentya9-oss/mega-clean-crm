# Password required to log into the CRM (single owner login, no username).
ADMIN_PASSWORD=changeme123

# Secret used to sign the session cookie. Change this in production.
SESSION_SECRET=dev-session-secret-change-me

# Port the Express/tRPC API server listens on.
PORT=4000

# Postgres (Supabase) connection the running app uses for normal queries — Supabase's pooled
# PgBouncer endpoint, port 6543, ?pgbouncer=true. Handles concurrent request-scoped connections
# well but doesn't support prepared statements across connections or DDL/migrations.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Direct (non-pooled) Postgres connection, port 5432 — used only for running migrations
# (`npm run db:migrate`) and by drizzle-kit generate/introspect, which need transaction-capable,
# non-PgBouncer access. Falls back to DATABASE_URL if not set.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Comma-separated list of allowed CORS origins for the API (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173
